#!/usr/bin/make -f

# Nothing is compiled here: the shared objects are built by the pipeline, in a
# container of the target distribution release, and this rules file only
# installs the set matching the build architecture.
#
# The compile cannot happen at package build time on Launchpad anyway --
# upstream declares rust-version = 1.92 and the newest rustc in the Ubuntu
# archive is 1.75 -- so the same tree serves the binary build and the source
# upload. dh_shlibdeps still runs here, which is the point: it resolves the
# dependencies against the release the package is actually built for.

DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

PLUGIN_DIR = debian/gst-plugins-rs-webrtc/usr/lib/$(DEB_HOST_MULTIARCH)/gstreamer-1.0
SOURCE_DIR = binaries/$(DEB_HOST_ARCH)/lib/gstreamer-1.0

%:
	dh $@

# Nothing is compiled here.
override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	@test -d $(SOURCE_DIR) || { \
	  echo "ERROR: no prebuilt plugins for $(DEB_HOST_ARCH) in $(SOURCE_DIR)"; \
	  exit 1; \
	}
	install -d $(PLUGIN_DIR)
	install -m 0644 $(SOURCE_DIR)/*.so $(PLUGIN_DIR)/

# The shared objects are already stripped by the build pipeline, and they have
# no separate debug symbols to split out.
override_dh_strip:
	dh_strip --no-automatic-dbgsym
